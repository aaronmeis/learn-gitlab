    <mxCell id="legend" value="&lt;b&gt;Steps&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;&lt;font color=&quot;#0B5F8A&quot;&gt;Front door&lt;/font&gt;&lt;/b&gt;&lt;br&gt;NGINX / Workhorse terminate TLS and Git HTTP.&lt;br&gt;&lt;br&gt;2. &lt;b&gt;&lt;font color=&quot;#0B5F8A&quot;&gt;Application&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Rails / Puma — 60s ceiling; long work offloads.&lt;br&gt;&lt;br&gt;3. &lt;b&gt;&lt;font color=&quot;#5B3AA8&quot;&gt;Queue and SoR&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Sidekiq / Redis then PostgreSQL.&lt;br&gt;&lt;br&gt;4. &lt;b&gt;&lt;font color=&quot;#0B5F8A&quot;&gt;Git RPC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Gitaly over gRPC — no shared NFS.&lt;br&gt;&lt;br&gt;5. &lt;b&gt;&lt;font color=&quot;#0A7A4F&quot;&gt;Job worker&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Runner pulls jobs outbound; never inbound shell." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
